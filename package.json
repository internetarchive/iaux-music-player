{
  "name": "@internetarchive/ia-music-player",
  "description": "An Internet Archive music player for archive.org items.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/internetarchive/iaux-music-player.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Internet Archive",
  "version": "1.2.4",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "scripts": {
    "start": "vite",
    "build": "tsc && cp -R ./images/ ./dist/images",
    "prepare": "npm run build && husky",
    "lint": "eslint . && prettier \"**/*.ts\" --check",
    "format": "eslint . --fix && prettier \"**/*.ts\" --write",
    "circular": "madge --circular --extensions ts .",
    "test": "npm run build && npm run lint && npm run circular && vitest run --coverage",
    "test:watch": "vitest",
    "ghpages:build": "rimraf ghpages && vite build && cp ./demo/liner-notes-manifest-demo.json ./ghpages/demo && cp ./demo/loose-images-demo.json ./ghpages/demo && cp ./demo/ghpages-index.html ./ghpages/index.html",
    "ghpages:publish": "npm run ghpages:prepare -e $(git branch --show-current)",
    "ghpages:prepare": "npm run ghpages:build && touch ghpages/.nojekyll && npm run ghpages:generate",
    "ghpages:generate": "gh-pages -t -d ghpages -m \"Build for $(git log --pretty=format:\"%h %an %ai %s\" -n1) [skip ci]\""
  },
  "types": "dist/index.d.ts",
  "dependencies": {
    "@internetarchive/ia-dropdown": "^2.2.0",
    "@internetarchive/iaux-item-metadata": "^1.2.0",
    "@internetarchive/icon-audio": "^1.4.1",
    "@internetarchive/icon-close-circle": "^1.4.1",
    "@internetarchive/metadata-service": "^1.0.6",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@open-wc/testing-helpers": "^3.0.1",
    "@types/node": "^26.1.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "chai-a11y-axe": "^1.5.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "madge": "^8.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "ts-lit-plugin": "^2.0.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lit": "$lit",
    "madge": {
      "typescript": "$typescript"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "es5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
